# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — nunca commitear credenciales
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# next-pwa (regenerated on `npm run build`)
public/sw.js
public/workbox-*.js
public/fallback-*.js

# el motor del mapa se copia en cada compilacion desde la libreria
/public/motor-del-mapa/

# la hoja de iconos del mapa se arma en cada compilacion: la de protomaps mas los propios
/public/iconos-del-mapa/light.json
/public/iconos-del-mapa/light.png
/public/iconos-del-mapa/light@2x.json
/public/iconos-del-mapa/light@2x.png
/public/iconos-del-mapa/dark.json
/public/iconos-del-mapa/dark.png
/public/iconos-del-mapa/dark@2x.json
/public/iconos-del-mapa/dark@2x.png
